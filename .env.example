# Copy to .env. Start in mock mode to connect Person 5's website.
PIPELINE_MODE=mock
PIPELINE_VERSION=v1
DATA_DIR=.local-data
JOB_TIMEOUT_SECONDS=300
MAX_PENDING_JOBS=20
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Set PIPELINE_MODE=team when these adapter functions exist.
# These are proposed contracts; adapt teammate functions to them.
COMPILER_CALLABLE=
SOLVER_CALLABLE=
CHECKER_CALLABLE=
FAKE_BACKEND=FakeGuadalupeV2

# Hardware is opt-in. No token is needed for mock/Aer/noisy runs.
IBM_ENABLED=false
IBM_TOKEN=
IBM_INSTANCE=
IBM_BACKEND=
